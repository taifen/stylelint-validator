{
  "name": "stylelint-csstree-validator",
  "version": "4.0.0",
  "description": "Stylelint plugin to validate CSS syntax",
  "repository": "csstree/stylelint-validator",
  "author": "Roman Dvornov <rdvornov@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "stylelint-plugin",
    "stylelint",
    "csstree",
    "css",
    "validator",
    "syntax"
  ],
  "scripts": {
    "test": "export NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" && mocha test --reporter ${REPORTER:-progress}",
    "lint": "eslint lib test",
    "coverage": "c8 --reporter=lcovonly npm test",
    "prepublishOnly": "npm run lint && npm run test"
  },
  "engines": {
    "node": ">=18.12.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "css-tree": "^2.3.1"
  },
  "peerDependencies": {
    "stylelint": "^16.0.0"
  },
  "devDependencies": {
    "c8": "^7.12.0",
    "eslint": "^8.33.0",
    "mocha": "^10.2.0",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.6",
    "stylelint": "^16.26.1"
  },
  "files": [
    "lib"
  ]
}
